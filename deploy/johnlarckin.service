[Unit]
Description=johnlarckin Flask app (gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/johnlarckin
Environment="PATH=/srv/johnlarckin/.venv/bin"
ExecStart=/srv/johnlarckin/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8001 \
    --access-logfile - \
    --error-logfile - \
    wsgi:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
